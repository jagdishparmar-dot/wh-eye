# PostgreSQL (Coolify: set as application environment variable)
DATABASE_URL=postgresql://user:password@host:5432/import

# Server (Coolify usually injects PORT automatically)
PORT=8000
TRUST_PROXY=1

# Gunicorn — keep low for a read-only map UI (defaults match Dockerfile)
WEB_CONCURRENCY=1
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=500
GUNICORN_MAX_REQUESTS_JITTER=50
MALLOC_ARENA_MAX=2

# Coolify (Dockerfile build): set in UI → Resource Limits, e.g.
#   CPU limit: 0.5 cores | Memory limit: 512 MB
# Or deploy with compose.yaml in this repo (cpus / mem_limit already set).

# Public URLs (intoship.cloud deployment)
APP_PUBLIC_URL=https://wh-eye.intoship.cloud
AUTH_LOGIN_URL=https://intoship.cloud

# Session gate — cookie set by intoship.cloud must include Domain=.intoship.cloud
# so wh-eye.intoship.cloud receives __session in the browser.
SESSION_COOKIE_NAME=__session

# Cache free_locations_mtr keys in memory (seconds)
FREE_LOCATIONS_CACHE_SECONDS=300

# Local dev only (no shared cookie on localhost):
# AUTH_DISABLED=1
