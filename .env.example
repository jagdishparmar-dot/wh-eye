# PostgreSQL (Coolify: set as application environment variable)
DATABASE_URL=postgresql://user:password@host:5432/import

# Server (Coolify usually injects PORT automatically)
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# Cache free_locations_mtr keys in memory (seconds)
FREE_LOCATIONS_CACHE_SECONDS=300
